NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (enlaces en correos transaccionales)
NEXT_PUBLIC_SITE_URL=https://conecta360.amaro.agency

# Admin 2FA OTP (panel /admin) — mínimo 32 caracteres aleatorios
ADMIN_OTP_SECRET=

# SMTP — OTP admin únicamente (no tocar al migrar correos de reuniones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@gmail.com
SMTP_PASS=
SMTP_FROM=Conecta360 Admin <admin@gmail.com>
ADMIN_OTP_EMAIL_TO=admin@gmail.com

# SMTP — reuniones confirmadas / canceladas (cuenta dedicada)
SMTP_TRANSACTIONAL_HOST=smtp.gmail.com
SMTP_TRANSACTIONAL_PORT=587
SMTP_TRANSACTIONAL_USER=conecta360.notificaciones@gmail.com
SMTP_TRANSACTIONAL_PASS=
SMTP_TRANSACTIONAL_FROM=Conecta360 · Orinoquía 2026 <conecta360.notificaciones@gmail.com>
SMTP_REPLY_TO=conecta360.notificaciones@gmail.com
